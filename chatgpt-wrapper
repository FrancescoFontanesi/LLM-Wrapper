#!/home/nihil/Extra/Chatgpt-PyGObject/.venv/bin/python
"""
Lightweight ChatGPT wrapper using GTK + WebKitGTK.

- Persists session data alongside the executable directory.
- Supports toggling visibility (ideal for Hyprland scratchpads).
- Performs periodic light cleanup while hidden to keep memory usage low.
"""
import argparse
import os
import sys
from pathlib import Path

import gi
from gi import Repository

repo = Repository.get_default()
webkit_versions = repo.enumerate_versions("WebKit2")
if "4.1" in webkit_versions:
    WEBKIT_VERSION = "4.1"
    GTK_VERSION = "3.0"
elif "4.0" in webkit_versions:
    WEBKIT_VERSION = "4.0"
    GTK_VERSION = "3.0"
else:  # pragma: no cover - critical configuration error
    raise ImportError("WebKitGTK introspection data (4.1/4.0) not available")

gi.require_version("Gtk", GTK_VERSION)
gi.require_version("WebKit2", WEBKIT_VERSION)

from gi.repository import Gio, GLib, GObject, Gtk, WebKit2

try:
    gi.require_version("Gdk", GTK_VERSION)
except ValueError:
    pass
try:
    gi.require_version("GdkWayland", GTK_VERSION)
except ValueError:
    try:
        gi.require_version("GdkWayland", "1.0")
    except ValueError:
        pass

try:
    from gi.repository import Gdk
except ImportError:  # pragma: no cover - optional dependency
    Gdk = None
try:
    from gi.repository import GdkWayland
except ImportError:  # pragma: no cover - optional dependency
    GdkWayland = None

APP_ID = "com.chatgpt.wrapper"
WAYLAND_APP_ID = "chatgpt-wrapper"
BASE_DIR = Path(__file__).resolve().parent
DATA_DIR = BASE_DIR / "session"
CACHE_DIR = BASE_DIR / "cache"
COOKIE_STORE = DATA_DIR / "cookies.sqlite"
URL = "https://chatgpt.com"
USER_AGENT = (
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/122 Safari/537.36"
)

DATA_DIR.mkdir(parents=True, exist_ok=True)
CACHE_DIR.mkdir(parents=True, exist_ok=True)
COOKIE_STORE.touch(exist_ok=True)


class ChatGPTApplication(Gtk.Application):
    """Minimal GTK application embedding WebKit with persistent storage."""

    def __init__(self) -> None:
        super().__init__(
            application_id=APP_ID,
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE,
        )
        self.window: Gtk.ApplicationWindow | None = None
        self.context: WebKit2.WebContext | None = None
        self.datamanager: WebKit2.WebsiteDataManager | None = None
        self.cookie_manager: WebKit2.CookieManager | None = None
        self.webview: WebKit2.WebView | None = None
        self._cleanup_timer_id: int = 0
        self._reload_timer_id: int = 0
        self._activate_suppressed = False
        self._user_agent_override: str | None = None

    # Gtk lifecycle -----------------------------------------------------
    def do_startup(self) -> None:  # type: ignore[override]
        Gtk.Application.do_startup(self)

        self.datamanager = WebKit2.WebsiteDataManager(
            base_data_directory=DATA_DIR,
            base_cache_directory=CACHE_DIR,
        )
        self.context = WebKit2.WebContext(website_data_manager=self.datamanager)
        if hasattr(self.datamanager, "set_itp_enabled"):
            try:
                self.datamanager.set_itp_enabled(False)
            except GLib.Error:
                pass
        if hasattr(self.datamanager, "set_persistent_credential_storage_enabled"):
            self.datamanager.set_persistent_credential_storage_enabled(True)
        self.cookie_manager = self.context.get_cookie_manager()

        if self.cookie_manager is not None:
            self.cookie_manager.set_accept_policy(WebKit2.CookieAcceptPolicy.ALWAYS)
            self.cookie_manager.set_persistent_storage(
                str(COOKIE_STORE), WebKit2.CookiePersistentStorage.SQLITE
            )

    def do_activate(self) -> None:  # type: ignore[override]
        self._ensure_window()

        if not self._activate_suppressed and self.window is not None:
            self.window.present()

        self._activate_suppressed = False

    def do_command_line(self, command_line: Gio.ApplicationCommandLine) -> int:  # type: ignore[override]
        parser = argparse.ArgumentParser(add_help=False)
        parser.add_argument("--toggle", action="store_true")
        parser.add_argument("--soft-clean", action="store_true")
        parser.add_argument("--hard-clean", action="store_true")
        parser.add_argument("--user-agent", type=str)
        parser.add_argument("--background", action="store_true")

        args = parser.parse_args(command_line.get_arguments()[1:])

        if args.user_agent:
            self._user_agent_override = args.user_agent

        if args.toggle or args.background:
            self._activate_suppressed = True

        self.activate()

        if args.user_agent:
            self._apply_user_agent(self._user_agent_override)

        if args.toggle and self.window is not None:
            if self.window.get_visible():
                self.window.hide()
            else:
                self.window.present()

        if args.background and self.window is not None:
            self.window.hide()

        if args.soft_clean:
            self.soft_clean()

        if args.hard_clean:
            self.hard_clean()

        return 0

    # Helpers -----------------------------------------------------------
    def soft_clean(self) -> None:
        if self.context is None or self.datamanager is None:
            return

        try:
            self.context.clear_cache()
        except GLib.Error:
            pass

        cleanup_types = (
            WebKit2.WebsiteDataTypes.MEMORY_CACHE
            | WebKit2.WebsiteDataTypes.DISK_CACHE
            | WebKit2.WebsiteDataTypes.OFFLINE_APPLICATION_CACHE
            | WebKit2.WebsiteDataTypes.SERVICE_WORKER_REGISTRATIONS
        )
        self.datamanager.clear(cleanup_types, 0, None, None, None)

    def hard_clean(self) -> None:
        if self.datamanager is None:
            return

        cleanup_types = WebKit2.WebsiteDataTypes.ALL & ~WebKit2.WebsiteDataTypes.COOKIES
        self.datamanager.clear(cleanup_types, 0, None, None, None)

    # Internal ----------------------------------------------------------
    def _ensure_window(self) -> None:
        if self.window is not None:
            return

        self.window = Gtk.ApplicationWindow(application=self)
        self.window.set_title("ChatGPT")
        self.window.set_default_size(1100, 800)
        self.window.connect("realize", self._on_window_realize)

        settings = WebKit2.Settings()
        settings.set_enable_smooth_scrolling(True)
        settings.set_enable_javascript(True)

        self.webview = WebKit2.WebView.new_with_context(self.context)
        self.webview.set_settings(settings)
        self._apply_user_agent(self._user_agent_override)
        self.webview.connect("load-changed", self._on_webview_load_changed)
        self.webview.connect("load-failed", self._on_webview_load_failed)
        self.webview.load_uri(URL)

        attach = getattr(self.window, "set_child", None)
        if attach is not None:
            attach(self.webview)
        else:
            # GTK3 fallback
            self.window.add(self.webview)
            self.webview.show()

        self.window.connect("notify::visible", self._on_visible_changed)

    def _apply_user_agent(self, override: str | None) -> None:
        if self.webview is None:
            return

        user_agent = override or USER_AGENT
        settings = self.webview.get_settings()

        if settings is not None and hasattr(settings, "set_user_agent"):
            settings.set_user_agent(user_agent)
        elif hasattr(self.webview, "set_custom_user_agent"):
            self.webview.set_custom_user_agent(user_agent)

    def _on_visible_changed(self, widget: Gtk.Widget, _pspec: GObject.ParamSpec) -> None:
        if widget.get_visible():
            self._stop_hidden_cleanup_timer()
        else:
            self._start_hidden_cleanup_timer()

    def _on_webview_load_changed(
        self, _webview: WebKit2.WebView, load_event: WebKit2.LoadEvent
    ) -> None:
        if load_event == WebKit2.LoadEvent.FINISHED:
            self._cancel_reload_retry()

    def _on_webview_load_failed(
        self,
        _webview: WebKit2.WebView,
        _load_event: WebKit2.LoadEvent,
        _failing_uri: str,
        _error: GLib.Error,
    ) -> bool:
        self._schedule_reload_retry()
        return False

    def _on_window_realize(self, window: Gtk.ApplicationWindow, *_) -> None:
        if Gdk is None:
            return

        get_surface = getattr(window, "get_surface", None) or getattr(window, "get_window", None)
        if get_surface is None:
            return

        surface = get_surface()
        if surface is None:
            return

        try:
            surface.set_app_id(WAYLAND_APP_ID)
        except AttributeError:
            if GdkWayland is not None and hasattr(GdkWayland, "window_set_app_id"):
                try:
                    GdkWayland.window_set_app_id(surface, WAYLAND_APP_ID)
                except Exception:
                    pass

    def _start_hidden_cleanup_timer(self) -> None:
        if self._cleanup_timer_id:
            return

        def _tick() -> bool:
            self.soft_clean()
            # Repeat while the window stays hidden.
            return self.window is not None and not self.window.get_visible()

        self._cleanup_timer_id = GLib.timeout_add_seconds(300, _tick)

    def _stop_hidden_cleanup_timer(self) -> None:
        if not self._cleanup_timer_id:
            return

        GLib.source_remove(self._cleanup_timer_id)
        self._cleanup_timer_id = 0

    def _schedule_reload_retry(self) -> None:
        if self._reload_timer_id:
            return

        # Retry loading ChatGPT periodically until it succeeds.
        def _retry() -> bool:
            if self.webview is None:
                return False

            self.webview.load_uri(URL)
            return True

        self._reload_timer_id = GLib.timeout_add_seconds(60, _retry)

    def _cancel_reload_retry(self) -> None:
        if not self._reload_timer_id:
            return

        GLib.source_remove(self._reload_timer_id)
        self._reload_timer_id = 0


def main(argv: list[str]) -> int:
    app = ChatGPTApplication()
    return app.run(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
