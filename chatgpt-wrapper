#!/usr/bin/env bash
#
# Ultra-fast launcher / CLI dispatcher for the web chat wrapper (ChatGPT by default;
# any web chat provider via --provider).
# Dispatches toggle, show, hide, and clean actions in ~2-5ms via Unix domain socket.
# If no instance is active, launches the primary GTK/WebKit backend.
#
set -e

INSTANCE=""
prev=""
for a in "$@"; do
    case "$a" in --instance=*) INSTANCE="${a#--instance=}" ;; esac
    [ "$prev" = "--instance" ] && INSTANCE="$a"
    prev="$a"
done
case "$INSTANCE" in *[!A-Za-z0-9_-]*) echo "chatgpt-wrapper: invalid --instance name" >&2; exit 2 ;; esac

SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/chatgpt-wrapper${INSTANCE:+-$INSTANCE}.sock"

# Fast-path: if wrapper daemon is active and nc is installed, dispatch immediately
if [ -S "$SOCK" ] && command -v nc >/dev/null 2>&1; then
    if [ $# -eq 0 ]; then payload='--toggle'; else payload="$(printf '%s\n' "$@")"; fi
    if printf '%s\n' "$payload" | nc -w 1 -U "$SOCK" 2>/dev/null | grep -q "OK"; then
        exit 0
    fi
fi

# Fallback / Initial launch: execute application via virtualenv python
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_PYTHON="$SCRIPT_DIR/.venv/bin/python"

export GDK_BACKEND="wayland,x11"

if [ -x "$VENV_PYTHON" ]; then
    exec "$VENV_PYTHON" "$SCRIPT_DIR/app.py" "$@"
else
    exec python3 "$SCRIPT_DIR/app.py" "$@"
fi
